# Copy to .env.local. Next.js reads that file. n8n can use the same one:
#   docker compose --env-file .env.local up
#
# Leave the secret fields empty in git. Fill them only in .env.local.

# Clerk, from the Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/board
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/board

# Convex client URL from the Convex dashboard
NEXT_PUBLIC_CONVEX_URL=

# Set these in the Convex dashboard as well (npx convex env set NAME value):
# CLERK_JWT_ISSUER_DOMAIN=
# ADMIN_EMAILS=
# LENDLOOP_OUTBOUND_WEBHOOK_SECRET=
# LENDLOOP_INBOUND_WEBHOOK_SECRET=
# N8N_WEBHOOK_URL=

# n8n. Generate the encryption key with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
CONVEX_SITE_URL=
LENDLOOP_OUTBOUND_WEBHOOK_SECRET=
LENDLOOP_INBOUND_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
